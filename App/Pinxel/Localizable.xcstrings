    "Drag over the image or move the handles. ⇧ keeps a square. Return crops, Esc cancels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe über das Bild oder bewege die Griffe. ⇧ behält ein Quadrat bei. Return schneidet zu, Esc bricht ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser sur l'image ou déplacez les poignées. ⇧ conserve un carré. Retour recadre, Échap annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina sull'immagine o sposta le maniglie. ⇧ mantiene un quadrato. Invio ritaglia, Esc annulla."
          }
        }
      }
    },
