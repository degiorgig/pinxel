    "The library index comes from a newer version of Pinxel: it was set aside in %@ and rebuilt from the files." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mediathek-Index stammt aus einer neueren Pinxel-Version: Er wurde in %@ beiseitegelegt und aus den Dateien neu aufgebaut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'index de la bibliothèque provient d'une version plus récente de Pinxel : il a été mis de côté dans %@ et reconstruit à partir des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indice della libreria è di una versione più recente di Pinxel: messo da parte in %@ e ricostruito dai file."
          }
        }
      }
    },
    "The library index was damaged and has been rebuilt from the files. Folders and tags were lost; a copy is in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mediathek-Index war beschädigt und wurde aus den Dateien neu aufgebaut. Ordner und Tags sind verloren; eine Kopie liegt in %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'index de la bibliothèque était endommagé : il a été reconstruit à partir des fichiers. Les dossiers et étiquettes sont perdus ; une copie se trouve dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'indice della libreria era danneggiato: ricostruito dai file. Cartelle ed etichette sono andate perse; la copia è in %@."
