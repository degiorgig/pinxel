        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scrivere in %@. Scegli un'altra cartella nelle Impostazioni."
          }
        }
      }
    },
    "Can't write to the library (%@). The capture stays outside the library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
