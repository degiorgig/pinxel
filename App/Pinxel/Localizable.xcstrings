    "Can't read the library index: folders and tags won't be saved until it is readable again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mediathek-Index kann nicht gelesen werden: Ordner und Tags werden erst wieder gesichert, wenn er lesbar ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire l'index de la bibliothèque : les dossiers et étiquettes ne seront pas enregistrés tant qu'il ne sera pas lisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere l'indice della libreria: cartelle ed etichette non si salvano finché non torna leggibile."
          }
        }
      }
    },
    "Can't write to %@. Choose another folder in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ kann nicht geschrieben werden. Wähle in den Einstellungen einen anderen Ordner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'écrire dans %@. Choisissez un autre dossier dans les Réglages."
