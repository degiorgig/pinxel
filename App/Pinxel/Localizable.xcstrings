    "It needs this to take screenshots. Images stay on your Mac. Grant access in System Settings → Privacy & Security → Screen & System Audio Recording, then relaunch Pinxel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist für Bildschirmfotos nötig. Die Bilder bleiben auf deinem Mac. Erlaube den Zugriff in Systemeinstellungen → Datenschutz & Sicherheit → Bildschirm- & Systemaudioaufnahme und starte Pinxel dann neu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est nécessaire pour faire des captures d'écran. Les images restent sur votre Mac. Autorisez l'accès dans Réglages Système → Confidentialité et sécurité → Enregistrement de l'écran et de l'audio système, puis relancez Pinxel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per catturare schermate. Le immagini restano sul tuo Mac. Concedi l'accesso in Impostazioni di Sistema → Privacy e sicurezza → Registrazione schermo e audio, poi riavvia Pinxel."
          }
        }
      }
    },
